# Shared MCP secrets for Pi/OpenCode.
# Copy this file to .env at the dotfiles repo root and fill values per machine.
# The real .env is intentionally git-ignored.

# Required by the local GitHub MCP server.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Required by the Postgres MCP server.
# Example format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URI=
